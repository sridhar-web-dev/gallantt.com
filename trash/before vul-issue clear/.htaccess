<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^(www\.)?gallantt\.com$ [NC]
RewriteRule ^(.*)$ https://gallantt.com/$1 [L,R=301]
</IfModule>
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^(www\.)?gallantt\.com$ [NC]
RewriteRule .* - [E=UPGRADE]
    <IfModule mod_headers.c>
        Header always set Content-Security-Policy "upgrade-insecure-requests;" env=UPGRADE
    </IfModule>
</IfModule>
RewriteEngine On
RewriteBase /gallantt/
RewriteEngine On
# Redirect sitemap.xml to sitemap.php
RewriteRule ^sitemap\.xml$ sitemap.php [L]
# --------------------------
# BLOG VIEW - SEO URL
# BLOG PAGINATION
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
# /blogs/2/ → pages/blogs.php?page=2
RewriteRule ^blogs/([0-9]+)/?$ pages/blogs.php?page=$1 [L,QSA]
# /blogs/desc/5/ → pages/blog-view.php?blog_id=5
RewriteRule ^blogs/desc/([0-9]+)/?$ pages/blog-view.php?blog_id=$1 [L,QSA]
</IfModule>
# MEDIA PAGINATION
# /gallantt/media/2/ → media.php?page=2
RewriteRule ^media/([0-9]+)/?$ pages/media.php?page=$1 [L,QSA]
# MEDIA VIEW
# /gallantt/media/desc/2/ → media-view.php?media_id=2
RewriteRule ^media/desc/([0-9]+)/?$ media-view.php?media_id=$1 [L,QSA]
# SEO-FRIENDLY .php REMOVAL FOR PAGES (optional)
# /gallantt/about-us → /gallantt/pages/about-us.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+?)/?$ /pages/$1.php [L,QSA]
# FALLBACK - ONLY if file exists without .php (optional)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/.]+)$ $1.php [L]
Redirect 301 /chairman/ https://gallantt.com/
Redirect 301 /contact/ https://gallantt.com/contact-us
Redirect 301 /team/ https://gallantt.com/about-us
Redirect 301 /news/ https://gallantt.com/media
Redirect 301 /projects/ https://gallantt.com/about-us
Redirect 301 /career/ https://gallantt.com/careers
Redirect 301 /home-4/ https://gallantt.com/
Redirect 301 /blog-1/ https://gallantt.com/blogs/
Redirect 301 /group-profile/ https://gallantt.com/about-us

<IfModule mod_headers.c>
    # Prevent MIME type sniffing
    Header set X-Content-Type-Options "nosniff"
    # Prevent clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    # Enable HTTPS enforcement (HSTS)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    # Optional: basic XSS protection
    Header set X-XSS-Protection "1; mode=block"
</IfModule>
